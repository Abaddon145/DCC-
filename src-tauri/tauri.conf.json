{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "栈藏 DCC 素材库",
  "version": "0.13.2",
  "identifier": "com.local.dccassetlibrary",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "栈藏 · DCC 素材库",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      },
      {
        "label": "reference-board",
        "title": "栈藏 · 参考板",
        "url": "index.html",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 320,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#0b0e13"
      }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' data: blob: http://dcc-media.localhost dcc-media:; media-src 'self' blob: http://dcc-media.localhost dcc-media:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://dcc-media.localhost dcc-media:" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "本地 DCC 与 Unreal Engine 素材管理器",
    "longDescription": "管理 DCC 素材元数据、预览图和百度网盘分享链接。",
    "category": "Productivity",
    "resources": ["resources/media-tools/**/*", "resources/THIRD_PARTY_NOTICES.md", "resources/THREE-LICENSE.txt"],
    "copyright": "Copyright © 2026",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
